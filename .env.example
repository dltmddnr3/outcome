# Generate locally; never commit real values.
OUTCOME_ACCESS_PASSWORD=replace-with-at-least-12-characters
OUTCOME_SESSION_SECRET=replace-with-at-least-32-random-characters
OUTCOME_HOST=127.0.0.1
OUTCOME_PORT=8787
# Explicit Cherry-approved public mode. Omit or set 0 to keep authentication required.
OUTCOME_PUBLIC_READ_ONLY=0
OUTCOME_CHERRY_NOTE_ROOT=/absolute/path/to/authoritative/cherry-note-candidate
OUTCOME_CHERRY_NOTE_ROLLOUT=/absolute/path/to/authoritative-rollout.jsonl
